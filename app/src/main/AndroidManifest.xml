<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Gallery clocks pick their tick back up after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Asked for once, on the way out of onboarding. A runtime permission from
        Android 13; below that, declaring it is the whole of it. Refusing is not final —
        it can be granted later from the app's own settings.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Lets a Gallery clock be woken on the minute rather than near it. An inexact
        alarm lands somewhere in a window the system chooses, and that window widens as
        the phone decides the app is idle — a minute hand some seconds late, and later
        the longer the phone is left alone.

        Asked for only when a clock is saved to the library, since nothing else here
        needs it, and given in Settings rather than by a prompt of ours: there is no
        runtime dialog for this one. Revocable at any time, so every alarm asks again
        before relying on it.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        Lets the app talk to Play's billing service, and is how Play knows to offer this
        app's subscriptions to it at all. Nothing is asked of the user for it: it grants
        no access to anything of theirs, so no prompt is ever shown.
    -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VisionWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Where a widget is told what to hold. The launcher opens this itself once a
          size has been dragged out of the picker, which is why it has to be exported:
          the caller is the launcher, not us. It is handed nothing but the widget's own
          id, and answers with that same id once the choice is written.
        -->
        <activity
            android:name=".widget.config.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.VisionWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!--
          Drives the Gallery clocks. The minute's tick is sent here by an alarm; the
          three system announcements are the ones that move a clock or a calendar on
          their own, and boot is where the tick is picked up again.
        -->
        <receiver
            android:name=".widget.GalleryTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.visionov.visionwidget.GALLERY_TICK" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Takes the launcher's word that a widget asked for from inside the app has
          landed, and writes onto it what it was asked to hold. Pinning skips the
          setting screen, so this is the only moment that choice can be recorded.
        -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.visionov.visionwidget.WIDGET_PINNED" />
            </intent-filter>
        </receiver>

        <!--
          One provider per size, and nothing in the manifest about what goes in them.
          Fifty-six used to be declared here, one per design, because the design was
          carried by the receiver class; it is carried by each widget's own state now.
          That is what collapsed the launcher's picker down to the three entries it is
          meant to show.
        -->
        <receiver
            android:name=".widget.SmallSlotReceiver"
            android:exported="false"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/slot_small_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MediumSlotReceiver"
            android:exported="false"
            android:label="@string/widget_label_medium">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/slot_medium_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.LargeSlotReceiver"
            android:exported="false"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/slot_large_widget_info" />
        </receiver>

    </application>

</manifest>
