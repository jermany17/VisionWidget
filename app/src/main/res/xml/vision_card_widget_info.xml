<?xml version="1.0" encoding="utf-8"?>
<!--
  The cell is asked for at about the height the card actually comes out, so the two
  meet. A card is as tall as the words in it and is fitted into whatever it is given,
  so a cell taller than the card leaves a transparent band above and below it — and
  two widgets sitting one under the other end up a long way apart.

  Not resizable. The card is a drawing with a proportion of its own, and the launcher's
  grid is the only say anyone has over the shape of the cell it goes in — dragging that
  about can only take the card further from what Studio shows.

  The preview is what the picker shows before the widget is placed. A Glance widget has
  no static layout to draw one from, and without it the picker says it cannot add the
  widget at all.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/preview_vision_medium"
    android:initialLayout="@layout/vision_widget_loading" />
