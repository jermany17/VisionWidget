<?xml version="1.0" encoding="utf-8"?>
<!--
  Four cells square, the proportion the face was drawn at. Half an hour is the shortest
  period the platform honours here; the hands are stepped forward by hand from the app
  rather than relied on from this.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/vision_widget_loading"
    android:description="@string/clock_widget_description" />
