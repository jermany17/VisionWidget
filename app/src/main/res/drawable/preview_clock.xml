<?xml version="1.0" encoding="utf-8"?>
<!-- What the launcher shows before the widget is placed. A still of the face's own
     surface: a Glance widget has no static layout to preview, and without something
     here the picker says it cannot add the widget at all. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#8A8688" />
    <stroke android:width="1dp" android:color="#47FFFFFF" />
</shape>
