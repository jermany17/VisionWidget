<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a serif V with a four-pointed star off its right shoulder.

  Drawn inside the middle two thirds of the 108 viewport, which is all an adaptive icon
  can count on keeping — a launcher is free to mask the rest away to whatever shape it
  likes, and the star sitting furthest out is the first thing that would go.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The heavy stroke, hung from its own serif: across the top bar, down the inner edge
      to the point, and back up the outer one. It narrows as it falls, which is what
      makes the letter read as cut rather than drawn.
    -->
    <path
        android:fillColor="#6E6156"
        android:pathData="M25.5,43.6 L47.5,43.6 L47.5,45.6 L43.8,45.6 L56.2,78.2 L54.4,80.4 L52.6,78.2 L30.2,45.6 L25.5,45.6 Z" />

    <!-- The hairline back up to the right, meeting the heavy stroke at the point. -->
    <path
        android:fillColor="#6E6156"
        android:pathData="M69.6,45.6 L71.2,46.3 L55.6,79.6 L54.0,78.9 Z" />

    <!--
      The star. Four points with the sides drawn in towards the middle, so it reads as a
      glint rather than as a diamond.
    -->
    <path
        android:fillColor="#6E6156"
        android:pathData="M74,28.5 C74.6,33.6 77.4,36.4 82.5,37 C77.4,37.6 74.6,40.4 74,45.5 C73.4,40.4 70.6,37.6 65.5,37 C70.6,36.4 73.4,33.6 74,28.5 Z" />
</vector>
